# Local Spring Boot configuration template. Copy to .env and replace every {PLACEHOLDER}.
# This file uses Java .properties syntax; do not source it as a shell script.
# The RDS identifier is dearus-dev. The JDBC database name is dearus (not dearus-dev).
# RDS is private, so a local process needs approved VPC access to connect.

# Required for startup. Use the RDS Endpoint hostname without a scheme or port.
DB_URL=jdbc:mariadb://{RDS_ENDPOINT}:3306/dearus?sslMode=verify-full
DB_USERNAME={DB_USERNAME}
DB_PASSWORD={DB_PASSWORD}
DEARUS_JWT_SECRET_BASE64={JWT_SECRET_BASE64}
KAKAO_APP_ID={NUMERIC_KAKAO_APP_ID}

# Required for Google login. This must be the audience accepted by the backend.
GOOGLE_CLIENT_ID={GOOGLE_CLIENT_ID}

# Swagger/OpenAPI. Leave the server URL empty to use the current host.
PORT=8080
SWAGGER_ENABLED=true
DEARUS_OPENAPI_SERVER_URL=

# Invitation link base URL; set before creating invitation links.
DEARUS_INVITATION_BASE_URL=

# Optional S3-backed profile images. Leave disabled until bucket and public URL are configured.
PROFILE_IMAGE_STORAGE_ENABLED=false
PROFILE_IMAGE_STORAGE_BUCKET=
PROFILE_IMAGE_STORAGE_REGION=ap-northeast-2
PROFILE_IMAGE_STORAGE_PUBLIC_BASE_URL=
PROFILE_IMAGE_STORAGE_ENDPOINT=

# Optional S3-backed baby images. Leave disabled until bucket and public URL are configured.
BABY_IMAGE_STORAGE_ENABLED=false
BABY_IMAGE_STORAGE_BUCKET=
BABY_IMAGE_STORAGE_REGION=ap-northeast-2
BABY_IMAGE_STORAGE_PUBLIC_BASE_URL=
BABY_IMAGE_STORAGE_ENDPOINT=
DEARUS_IMAGE_PRESIGNED_GET_TTL=PT1H

# Voice is disabled by default. For Railway OpenAI, set both providers to OPENAI,
# both feature flags to true, the OpenAI model names, and a NEW secret key.
DEARUS_VOICE_ENABLED=false
DEARUS_VOICE_MAX_AUDIO_BYTES=5242880
DEARUS_STT_ENABLED=false
DEARUS_STT_PROVIDER=GOOGLE_SPEECH
DEARUS_STT_MODEL=short
DEARUS_STT_TIMEOUT_MS=30000
DEARUS_STT_LOCATION=global
DEARUS_STT_LANGUAGE_CODE=ko-KR
DEARUS_LLM_ENABLED=false
DEARUS_LLM_PROVIDER=VERTEX_GEMINI
DEARUS_LLM_MODEL=gemini-2.5-flash
DEARUS_LLM_TIMEOUT_MS=30000
OPENAI_API_KEY=

# Google STT / Vertex Gemini only; not needed when both providers are OPENAI.
DEARUS_GOOGLE_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
